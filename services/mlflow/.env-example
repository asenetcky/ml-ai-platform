#version=1.1
#URL=https://github.com/tailscale-dev/ScaleTail
#COMPOSE_PROJECT_NAME= # Optional: only use when running multiple deployments on the same infrastructure.

# Service Configuration
SERVICE=mlflow # Service name. Used as hostname in Tailscale and for container naming (app-${SERVICE}).
IMAGE_URL=ghcr.io/mlflow/mlflow:latest # Docker image URL from container registry.

# Network Configuration
SERVICEPORT=5000 # MLflow's UI/API port. Uncomment the "ports:" section in compose.yaml to expose to LAN.
DNS_SERVER=9.9.9.9 # Preferred DNS server for Tailscale. Uncomment the "dns:" section in compose.yaml to enable.

# Tailscale Configuration
TS_AUTHKEY= # Auth key from https://tailscale.com/admin/authkeys. See: https://tailscale.com/kb/1085/auth-keys#generate-an-auth-key for instructions.

# MLflow Security (DNS rebinding protection)
# MLflow rejects requests whose Host header is not in this allowlist. Comma-separated, no spaces.
# Include your Tailnet FQDN (e.g. mlflow.<tailnet-name>.ts.net) plus localhost for local access.
# Use "*" to disable the check entirely (not recommended).
ALLOWED_HOSTS=mlflow.your-tailnet-name.ts.net,localhost,127.0.0.1
# Origins allowed for browser (CORS) requests. Usually the HTTPS URL(s) you load the UI from.
CORS_ALLOWED_ORIGINS=https://mlflow.your-tailnet-name.ts.net

# Time Zone setting for containers
TZ=Europe/Amsterdam # See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones

#EXAMPLE_VAR="Environment variable"
